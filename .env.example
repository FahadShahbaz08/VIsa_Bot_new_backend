# MongoDB connection string used by config/db.js.
# Copy this file to .env, then replace every placeholder.
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database-name>?retryWrites=true&w=majority&appName=<app-name>

# Generate a unique secret with at least 32 random bytes. Never commit the real value.
JWT_SECRET=replace-with-a-long-random-secret


# Used only when running the Express server locally. Vercel assigns its own port.
PORT=4000
